{
  // Cloudflare Workers Configuration
  // This file configures your project for deployment to Cloudflare Workers
  
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  
  // Main worker entry point
  "main": "index.js",
  
  // Specify compatibility date for Cloudflare Workers runtime
  "compatibility_date": "2025-01-01",
  
  // Static Assets configuration for Workers
  "assets": {
    // The path to the directory containing the static files
    "directory": "./public",
    // Binding name to access assets in the worker
    "binding": "ASSETS"
  },
  
  // KV namespace bindings for the TOD app
  "kv_namespaces": [
    {
      "binding": "TOD_KV",
      "id": "41a69c0f17014c42a7d9ab630f46fcac",
      "preview_id": "e6c74278e75e4072a9946641c27c85d2"
    }
  ],
  
  // Enable observability
  "observability": {
    "enabled": true
  }
  
  // Optional: Environment variables for production
  // "vars": {
  //   "ENVIRONMENT": "production"
  // },
  
  // Optional: Smart Placement
  // "placement": { "mode": "smart" }
}
